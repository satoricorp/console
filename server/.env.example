# Local server runtime. `bun run dev`, `bun run start`, and `bun run migrate`
# source the repo-root `.env` first, then `server/.env`.

PORT=3201

# Choose one database configuration.
# DATABASE_URL=postgres://tx:tx@localhost:5432/tx
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=tx
# PGUSER=tx
# PGPASSWORD=tx
# PGSSLMODE=disable

# Bedrock local development. The server hardcodes its own model, and
# /gx/bedrock/fight hardcodes the allowlist it will proxy for the CLI.
# Prefer AWS_PROFILE. If you set direct keys, keep them only in ignored .env files.
AWS_PROFILE=gx-local
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Bounds for the /gx/bedrock/fight passthrough (defaults shown).
# TX_CLOUD_BEDROCK_MAX_BODY_BYTES=2097152
# TX_CLOUD_BEDROCK_TIMEOUT_MS=300000

# Optional providers and services.
# OPENAI_API_KEY=
# TX_OPENAI_API_KEY=
# TX_OPENAI_BASE_URL=
# TX_REVIEW_OPENAI_MODEL=gpt-4o-mini
# Convex (CLI auth verify + trial entitlement for community bonus days)
# CONVEX_SITE_URL=https://your-deployment.convex.site
# TX_CLOUD_API_KEY=dev-secret
# PostHog (server). Use tx-staging locally; production key in AWS Secrets Manager.
# TX_POSTHOG_KEY=
# TX_POSTHOG_HOST=https://f.gx.run
# TURBOPUFFER_API_KEY=
# OSS "watch" rail (Phase 1). Dormant unless TX_WATCH_ENABLED is 1/true.
# TX_WATCH_ENABLED=0
# TX_WATCH_GITHUB_TOKEN=   # PAT for the TX bot user: public_repo read + PR comment write
# TX_WATCH_LINK_BASE=https://gx.run/oss   # tracked-link landing page (optional; this is the default)
# Convex-side env (set in the Convex dashboard, not here): TX_SERVER_INTERNAL_URL
# must point at this server so the oss-watch-poll cron can reach /internal/watch/tick.
