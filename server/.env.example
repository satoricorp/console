# Local server runtime. `bun run dev`, `bun run start`, and `bun run migrate`
# source the repo-root `.env` first, then `server/.env`.

PORT=3201

# Choose one database configuration.
# DATABASE_URL=postgres://gx:gx@localhost:5432/gx
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=gx
# PGUSER=gx
# PGPASSWORD=gx
# PGSSLMODE=disable

# Bedrock local development. The server hardcodes the model.
# Prefer AWS_PROFILE. If you set direct keys, keep them only in ignored .env files.
AWS_PROFILE=gx-local
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional providers and services.
# OPENAI_API_KEY=
# GX_OPENAI_API_KEY=
# GX_OPENAI_BASE_URL=
# GX_REVIEW_OPENAI_MODEL=gpt-4o-mini
# Convex (CLI auth verify + trial entitlement for community bonus days)
# CONVEX_SITE_URL=https://your-deployment.convex.site
# GX_CLOUD_API_KEY=dev-secret
# PostHog (server). Use gx-staging locally; production key in AWS Secrets Manager.
# GX_POSTHOG_KEY=
# GX_POSTHOG_HOST=https://f.gx.run
# TURBOPUFFER_API_KEY=
