{
  "name": "@tx/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "scripts/with-env.sh bun --watch src/index.ts",
    "start": "scripts/with-env.sh bun src/index.ts",
    "migrate": "scripts/with-env.sh bun src/migrate.ts",
    "review:playground": "scripts/with-env.sh bun scripts/review-playground.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:db": "scripts/test-db.sh",
    "test:db:keep": "scripts/test-db.sh --keep"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1071.0",
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.10",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
