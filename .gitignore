# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
server/node_modules
infra/node_modules
server/dist
infra/cdk.out
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# gx cold-outreach generated artifacts (not for commit)
outreach-out/

# `gx review` writes its full JSON report here. The command also adds this path
# to .git/info/exclude, but that file is per-machine — listed here so everyone
# gets it, not just whoever ran the review.
/review/
.demo-wheel/
