# --- Next.js (.env.local) ---

# Written by `bunx convex dev`
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Convex deployment ---
# Set with `bunx convex env set <KEY> <VALUE>` (production)
# For local dev, these can also live in .env.local and are read by `convex dev`.

BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub OAuth app callback URL (Next.js proxies /api/auth to Convex):
# http://localhost:3000/api/auth/callback/github
