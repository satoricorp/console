# --- Next.js (.env.local) ---
# Copy to .env.local and fill in values. `bunx convex dev` syncs Convex vars from here.

# Written by `bunx convex dev`
CONVEX_DEPLOYMENT=

# Convex deployment URL (browser + server)
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL (Better Auth). If unset in Next.js,
# standard .convex.site deployments are derived from NEXT_PUBLIC_CONVEX_URL.
NEXT_PUBLIC_CONVEX_SITE_URL=

# gx logos always use the checked-in Blender meshes (see gx-logo/constants.ts).

# GitHub repo + community links (marketing nav/footer)
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/satoricorp/gx
# NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite
# NEXT_PUBLIC_TWITTER_URL=https://x.com/satori_corp  # @satori_corp

# PostHog analytics (browser). Use gx-staging locally; production key on Vercel Production.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://f.gx.run

# Reviews kill switch (src/lib/feature-flags.ts). Defaults: on in dev, off in
# production builds. Set to 1 to relaunch reviews in production (build-time —
# needs a redeploy), or 0 to hide the surface in dev.
# NEXT_PUBLIC_REVIEWS_ENABLED=

# --- Convex deployment env ---
# Also set in .env.local for local `convex dev`, or via:
#   bunx convex env set <KEY> <VALUE>

# gx Cloud API key (shared with Console server for internal calls)
# GX_CLOUD_API_KEY=dev-secret

# Better Auth
BETTER_AUTH_SECRET=
# App URL for OAuth callbacks
SITE_URL=http://localhost:3000

# GitHub App OAuth (repo scope is requested for CLI auth and repository onboarding)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GITHUB_CLIENT_ID above is the single gx OAuth client: the Console's web
# sign-in and the CLI's `gx auth login` device flow both use it. The secret is
# not only for the sign-in exchange — an inbound GitHub access token is accepted
# as a gx login only if GitHub's check-token API, authenticated with this pair,
# says the token was issued for this client. Unset means every such token is
# refused.

# Turbo Puffer indexing (Convex internal worker — set via `bunx convex env set`)
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
OPENAI_API_KEY=

# GitHub App you create (Settings → Developer settings → GitHub Apps).
# Webhook URL: https://<your-api-host>/github/webhook
#   (this server; it forwards the deliveries Convex needs). GitHub must reach it.
# Permissions: contents (read/write), pull_requests (read/write), issues (read/write),
#   checks (read), actions (read).
# Events: installation, installation_repositories, pull_request, pull_request_review,
#   pull_request_review_comment, issue_comment, push.
# GITHUB_APP_INSTALL_URL is that app's install page:
#   https://github.com/apps/<your-app-slug>/installations/new
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALL_URL=
# Signs inbound GitHub webhooks. The Console server reads the same name from its
# own secret; unset means every delivery fails signature verification.
GITHUB_WEBHOOK_SECRET=

# Stripe. convex/stripeCheckout.ts starts Checkout sessions for /checkout and
# convex/stripeWebhookActions.ts mirrors the resulting subscription into
# billingCustomers/subscriptions, which is what convex/runs.ts consults once a
# user's free runs are spent. STRIPE_PRICE_ID is the recurring $20/month price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# PostHog server-side capture (convex/gxAuthActions.ts, server/src/telemetry).
# Distinct from the NEXT_PUBLIC_POSTHOG_* pair above, which is browser-side.
# GX_POSTHOG_HOST=https://f.gx.run
# GX_POSTHOG_KEY=

# Base URL Convex uses to reach the Console server for the OSS watch cron
# (convex/crons.ts → watchlistActions.runWatchTick). Unset makes every tick a
# no-op, which is the intended state until the watch rail is live.
# GX_SERVER_INTERNAL_URL=http://localhost:3201

# --- gx Cloud API + Console server API layer ---
# Postgres is owned by the Console server. The Next.js app proxies bookmark
# CRUD via GX_CLOUD_URL and sends service auth plus X-User-Id.
# GX_CLOUD_URL=http://localhost:3201
# GX_CLOUD_API_KEY — declared once above; the server and Convex must agree on it.
#
# After `gx pr`, the server writes Postgres via POST /v1/publish.
# Local Postgres (Homebrew): brew services start postgresql@16 && createdb gx
# Optional Docker Postgres: docker compose up -d postgres
# DATABASE_URL=postgres://localhost:5432/gx  # Console server only
# CONVEX_URL=                       # same as NEXT_PUBLIC_CONVEX_URL
# PORT=3201
# CONSOLE_SITE_URL=http://localhost:3000
#
# CLI auth (Convex HTTP on CONVEX_SITE_URL):
#   POST /cx/auth/complete
# Trial entitlement (server → Convex, requires GX_CLOUD_API_KEY on both):
#   POST /cx/trial/entitlement
#
# Dev:
#   cd server && bun install && bun run migrate && bun run dev
#
#   http://localhost:3000/api/auth/callback/github
