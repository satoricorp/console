# --- Next.js (.env.local) ---
# Copy to .env.local and fill in values. `bunx convex dev` syncs Convex vars from here.

# Written by `bunx convex dev`
CONVEX_DEPLOYMENT=

# Convex deployment URL (browser + server)
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL (Better Auth + Stripe webhooks)
NEXT_PUBLIC_CONVEX_SITE_URL=

# App URL for OAuth callbacks and billing return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use Blender meshes: header gx-icon.glb, hero gx-chrome.glb (see gx-logo/constants.ts)
NEXT_PUBLIC_GX_LOGO_MESH=false

# GitHub repo + community links (marketing nav/footer)
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/satoricorp/gx
# NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# macOS desktop app download (homepage + /download)
# NEXT_PUBLIC_GX_DAEMON_MACOS_URL=https://github.com/satoricorp/gx/releases/latest

# Set both to "true" to show trial signup on /billing.
NEXT_PUBLIC_STRIPE_SIGNUP_ENABLED=false

# Stripe publishable key (browser — Payment Element on /billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Convex deployment env ---
# Also set in .env.local for local `convex dev`, or via:
#   bunx convex env set <KEY> <VALUE>

# Better Auth
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000

# Optional dedicated HMAC pepper for MCP API key hashes. Falls back to BETTER_AUTH_SECRET.
API_KEY_HASH_SECRET=

# GitHub App OAuth (repo scope is requested for CLI auth and repository onboarding)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (server — Convex actions + webhooks)
# Must match NEXT_PUBLIC_STRIPE_SIGNUP_ENABLED when enabling billing.
STRIPE_SIGNUP_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price for after trial (e.g. $28/month = 2800 cents in Stripe Dashboard)
STRIPE_PRICE_ID=price_...
STRIPE_TRIAL_DAYS=14
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Turbo Puffer indexing (Convex internal worker — set via `bunx convex env set`)
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
OPENAI_API_KEY=

# GitHub App (optional — merge re-index via Convex HTTP webhook)
# Required app permissions: contents (read/write), pull_requests (read), checks (read), actions (read).
# Optional for later rerun support: actions (write).
# Webhook URL: https://<deployment>.convex.site/cx/github/webhook
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALL_URL=
GITHUB_WEBHOOK_SECRET=

# --- GX Cloud API + Console server API layer ---
# Postgres is owned by the Console server. The Next.js app proxies bookmark
# CRUD via GX_CLOUD_URL and sends service auth plus X-User-Id.
# GX_CLOUD_URL=http://localhost:3201
# GX_CLOUD_API_KEY=dev-secret
#
# After `gx pr`, the server writes Postgres via POST /v1/publish.
# Local Postgres (Homebrew): brew services start postgresql@16 && createdb gx
# Optional Docker Postgres: docker compose up -d postgres
# DATABASE_URL=postgres://localhost:5432/gx  # Console server only
# CONVEX_URL=                       # same as NEXT_PUBLIC_CONVEX_URL
# PORT=3201
# CONSOLE_SITE_URL=http://localhost:3000
#
# CLI auth (Convex HTTP on CONVEX_SITE_URL):
#   POST /cx/auth/complete
#   POST /cx/auth/revoke
#
# Server resolves CLI tokens via Convex SDK: gxAuth.resolveCliToken
#
# Dev:
#   cd server && bun install && bun run migrate && bun run dev

#   http://localhost:3000/api/auth/callback/github
#
# Stripe webhook endpoint (Convex HTTP action):
#   https://<deployment>.convex.site/cx/stripe/webhook
#
# Stripe webhook events to enable:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   customer.updated
#   setup_intent.succeeded
#
# Local webhooks (Stripe CLI):
#   stripe listen --forward-to https://<deployment>.convex.site/cx/stripe/webhook
