# --- Next.js (.env.local) ---
# Copy to .env.local and fill in values. `bunx convex dev` syncs Convex vars from here.

# Written by `bunx convex dev`
CONVEX_DEPLOYMENT=

# Convex deployment URL (browser + server)
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL (Better Auth). If unset in Next.js,
# standard .convex.site deployments are derived from NEXT_PUBLIC_CONVEX_URL.
NEXT_PUBLIC_CONVEX_SITE_URL=

# GX logos always use the checked-in Blender meshes (see gx-logo/constants.ts).

# GitHub repo + community links (marketing nav/footer)
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/satoricorp/gx
# NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# macOS desktop app download (/download)
# NEXT_PUBLIC_GX_DAEMON_MACOS_URL=https://download.gx.run/GX-macOS.dmg
# NEXT_PUBLIC_GX_DAEMON_MACOS_ZIP_URL=https://download.gx.run/GX-macOS.zip

# PostHog analytics (browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://f.gx.run

# PostHog analytics (browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Convex deployment env ---
# Also set in .env.local for local `convex dev`, or via:
#   bunx convex env set <KEY> <VALUE>

# Better Auth
BETTER_AUTH_SECRET=
# App URL for OAuth callbacks
SITE_URL=http://localhost:3000

# GitHub App OAuth (repo scope is requested for CLI auth and repository onboarding)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Turbo Puffer indexing (Convex internal worker — set via `bunx convex env set`)
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
OPENAI_API_KEY=

# GitHub App (optional — merge re-index via Convex HTTP webhook)
# Required app permissions: contents (read/write), pull_requests (read), checks (read), actions (read).
# Optional for later rerun support: actions (write).
# Webhook URL: https://<deployment>.convex.site/cx/github/webhook
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALL_URL=
GITHUB_WEBHOOK_SECRET=

# --- GX Cloud API + Console server API layer ---
# Postgres is owned by the Console server. The Next.js app proxies bookmark
# CRUD via GX_CLOUD_URL and sends service auth plus X-User-Id.
# GX_CLOUD_URL=http://localhost:3201
# GX_CLOUD_API_KEY=dev-secret
#
# After `gx pr`, the server writes Postgres via POST /v1/publish.
# Local Postgres (Homebrew): brew services start postgresql@16 && createdb gx
# Optional Docker Postgres: docker compose up -d postgres
# DATABASE_URL=postgres://localhost:5432/gx  # Console server only
# CONVEX_URL=                       # same as NEXT_PUBLIC_CONVEX_URL
# PORT=3201
# CONSOLE_SITE_URL=http://localhost:3000
#
# CLI auth (Convex HTTP on CONVEX_SITE_URL):
#   POST /cx/auth/complete
#
# Dev:
#   cd server && bun install && bun run migrate && bun run dev
#
#   http://localhost:3000/api/auth/callback/github
