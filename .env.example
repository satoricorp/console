# --- Next.js (.env.local) ---
# Copy to .env.local and fill in values. `bunx convex dev` syncs Convex vars from here.

# Written by `bunx convex dev`
CONVEX_DEPLOYMENT=

# Convex deployment URL (browser + server)
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL (Better Auth + Stripe webhooks)
NEXT_PUBLIC_CONVEX_SITE_URL=

# App URL for OAuth callbacks and billing return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use Blender meshes: header gx-icon.glb, hero gx-chrome.glb (see gx-logo/constants.ts)
NEXT_PUBLIC_GX_LOGO_MESH=false

# Stripe publishable key (browser — Payment Element on /billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Convex deployment env ---
# Also set in .env.local for local `convex dev`, or via:
#   bunx convex env set <KEY> <VALUE>

# Better Auth
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000

# GitHub OAuth (repo scope is requested for repository onboarding)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (server — Convex actions + webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price for after trial (e.g. $28/month = 2800 cents in Stripe Dashboard)
STRIPE_PRICE_ID=price_...
STRIPE_TRIAL_DAYS=14
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Turbo Puffer indexing (Convex + services/turbo-puffer)
TURBO_PUFFER_SERVICE_URL=http://localhost:3100
TURBO_PUFFER_SERVICE_SECRET=
TURBO_PUFFER_CALLBACK_SECRET=
# Convex site URL — used for turbo-puffer job callbacks (same as NEXT_PUBLIC_CONVEX_SITE_URL)
CONVEX_SITE_URL=

# --- services/turbo-puffer (.env in services/turbo-puffer/) ---
# TURBOPUFFER_API_KEY=
# TURBOPUFFER_REGION=gcp-us-central1
# OPENAI_API_KEY=
# TURBO_PUFFER_SERVICE_SECRET=        # must match Convex
# TURBO_PUFFER_CALLBACK_SECRET=       # must match Convex
# CONVEX_SITE_URL=                  # Convex deployment .site URL
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=       # optional; set from webhook if omitted
# GITHUB_WEBHOOK_SECRET=
# PORT=3100

#   http://localhost:3000/api/auth/callback/github
#
# Stripe webhook endpoint (Convex HTTP action):
#   https://<deployment>.convex.site/stripe/webhook
#
# Stripe webhook events to enable:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   customer.updated
#   setup_intent.succeeded
#
# Local webhooks (Stripe CLI):
#   stripe listen --forward-to https://<deployment>.convex.site/stripe/webhook
